{
  "name": "clinic-reminder-proof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:api": "cargo run --manifest-path services/api/Cargo.toml",
    "test": "npm run test:web && npm run test:api && npm run test:e2e",
    "test:web": "vitest run",
    "test:api": "cargo test --manifest-path services/api/Cargo.toml",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig apps/web/tsconfig.json && cargo fmt --manifest-path services/api/Cargo.toml --check && cargo clippy --manifest-path services/api/Cargo.toml --all-targets -- -D warnings",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:api": "cargo build --release --manifest-path services/api/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.1",
    "svelte": "5.56.10",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
