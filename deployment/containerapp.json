{
  "properties": {
    "template": {
      "containers": [
        {
          "name": "app",
          "volumeMounts": [
            {
              "volumeName": "clinic-data",
              "mountPath": "/durable"
            },
            {
              "volumeName": "clinic-backups",
              "mountPath": "/backups"
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "clinic-data",
          "storageType": "AzureFile",
          "storageName": "clinic-reminder-proof-data"
        },
        {
          "name": "clinic-backups",
          "storageType": "AzureFile",
          "storageName": "clinic-reminder-proof-backups"
        }
      ],
      "scale": {
        "minReplicas": 1,
        "maxReplicas": 1,
        "pollingInterval": 30,
        "cooldownPeriod": 300
      }
    }
  }
}
